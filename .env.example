# --- Required ---------------------------------------------------------------
# Shared HS256 secret with the WebBlock auth service (Spring Boot gateway), or use AUTH_JWT_PUBLIC_KEY for RS256.
AUTH_JWT_SECRET=change-me-to-a-long-random-string
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# AUTH_JWT_ALGORITHMS=["RS256"]
# AUTH_JWT_ISSUER=https://auth.webblock.example
# AUTH_JWT_AUDIENCE=webblock-harness
# AUTH_TENANT_CLAIM=tenant_id
# AUTH_ROLES_CLAIM=roles

# GitHub organisation that owns every client repository, and a token for it
# (fine-grained: contents, pull requests, actions, checks, metadata on the org's client repos).
GITHUB_ORG=your-webblock-org   # GITHUB_ORGANIZATION_NAME is accepted as an alias
GITHUB_ORGANIZATION_KEY=github_pat_xxx   # GITHUB_TOKEN is accepted as an alias

# LLM for ambiguous intent + source-code planning/generation
# Local model via Ollama (no API key; `ollama pull qwen2.5-coder:7b` first):
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=32768             # context window requested from Ollama
# OLLAMA_TIMEOUT_SECONDS=600
# Or Claude:
# LLM_PROVIDER=anthropic          # or "none" for rules-only (Path B then fails clearly)
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-xxx
# LLM_EFFORT=high

# --- Persistence -------------------------------------------------------------
# DATABASE_URL=sqlite:///./var/harness.db
# DATABASE_URL=postgresql+psycopg://harness:***@db:5432/harness   (install psycopg)
# ARTIFACT_DIR=./var/artifacts

# --- Website builder ------------------------------------------------------------
# DEV_LOGIN_ENABLED=true          # local email sign-in for the web app at /app/ (development only!)
# NEW_REPO_PRIVATE=true           # visibility of repositories created for new sites
# NEW_REPO_SUFFIX=-site
# PORTAL_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...Ed25519...\n-----END PRIVATE KEY-----"   # production; keep stable
# PORTAL_KEY_FILE=./var/portal_signing_key.pem   # development: generated automatically
# DEFAULT_SITE_URL=http://localhost:3000

# --- Delivery & deployment -----------------------------------------------------
# CONFIG_DELIVERY_MODE=commit     # commit: config committed to the repo (default) ; runtime: sites fetch /v1/public/sites/{site_key}/config
# CONFIG_REPO_PATH=webblock/site-config.json
# DEPLOY_PROVIDER=github_push     # default: deployed = verified push to the org repo; or github_actions / fake
# DEPLOY_WORKFLOW_FILE=deploy.yml
# DEPLOY_VERIFY_URL_TEMPLATE=https://{repo_name}.webblock.app/api/webblock/version
# RUNTIME_REVALIDATE_URL_TEMPLATE=https://{repo_name}.webblock.app/api/webblock/revalidate
# RUNTIME_REVALIDATE_SECRET=change-me
# PREVIEW_URL_TEMPLATE=https://preview.webblock.app/{site_key}?revision={revision_id}

# --- CI checks required on job branches (JSON lists of check-run names) ------------
# REQUIRED_CHECKS_FRONTEND=["format","typecheck","lint","test","build"]
# REQUIRED_CHECKS_BACKEND=["integration-tests"]
# REQUIRED_CHECKS_DATABASE=["migration-test"]

# --- Execution -----------------------------------------------------------------
# GIT_PROVIDER=github             # or "memory" for local development without GitHub
# JOB_EXECUTION=background        # or "inline"
# JOB_WORKERS=4
# POLL_INTERVAL_SECONDS=10
# CI_TIMEOUT_SECONDS=1800
# DEPLOY_TIMEOUT_SECONDS=1800
# PROJECT_LOCK_TTL_SECONDS=3600
# LOG_LEVEL=INFO
